
    digraph BMU_UVM_ENV {
        graph [
            rankdir=TB,
            nodesep=0.7,
            ranksep=1.1,
            bgcolor="white",
            pad=0.2,
            fontname="Helvetica"
        ];
        node [shape=box, style="filled,rounded", fillcolor="#f7f3ff", color="#6c5b9b", fontname="Helvetica", margin="0.12,0.08"];
        edge [color="#4b3d7a", arrowsize=0.8];

        subgraph cluster_test {
            label="UVM test";
            color="#c7b8e8";
            test [label="bmu_*_test
selects sequence"];
            seq [label="sequence
legal/random/direct"];
        }

        subgraph cluster_env {
            label="Testbench environment";
            color="#cfe8ff";
            env [label="bmu_environment"];
            agent [label="bmu_agent
(driver + monitor + sequencer)"];
            ref [label="bmu_reference_model
expected results"];
            sb [label="bmu_scoreboard
actual vs expected"];
            cov [label="bmu_coverage
functional coverage"];
        }

        subgraph cluster_dut {
            label="DUT bridge";
            color="#d9f2d9";
            vif [label="bmu_interface
clocking blocks + modports"];
            dut [label="Bit_Manipulation_Unit
RTL DUT"];
        }

        test -> seq;
        seq -> agent;
        agent -> vif;
        vif -> dut;
        dut -> vif;
        vif -> agent;

        agent -> ref [label="monitor txn"];
        agent -> sb [label="actual txn"];
        ref -> sb [label="expected txn"];
        agent -> cov [label="sample"];
        sb -> report [label="pass/fail"];
        cov -> report [label="coverage bins"];

        report [label="simulation log
+ coverage DB"];
    }
    